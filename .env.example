# 5TOT backend environment example. Do not put real secrets in this file.

# Required: runtime
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sv5tot
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.com
DEFAULT_SCHOOL_YEAR=2026-2027
LOG_LEVEL=info

# Required: auth secrets. Use long random values outside local dev.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=120m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
SEED_DEFAULT_PASSWORD=Password@123

# Pilot-only: requires a local disposable PostgreSQL database with "pilot" in its name.
# Never point pilot bootstrap commands at Supabase or production.
PILOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sv5tot_pilot
PILOT_BOOTSTRAP_CONFIRM=false
PILOT_BOOTSTRAP_PASSWORD=
PILOT_SCHOOL_YEAR=2026-2027
PILOT_SCHOOLS_JSON=
PILOT_STAFF_JSON=
# Required ISO-8601 submission window plus optional review/supplement/finalization deadlines.
PILOT_SEASON_DATES_JSON=

# Optional compatibility aliases for older local scripts.
JWT_SECRET=
JWT_EXPIRES_IN=
BCRYPT_ROUNDS=

# Required for Cloud Run/stateless file storage.
STORAGE_DRIVER=r2
MAX_FILE_SIZE_MB=20
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=your-r2-bucket
R2_BUCKET_NAME=
R2_ACCOUNT_ID=<ACCOUNT_ID>
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Optional local-only storage. Do not use local storage for Cloud Run production uploads.
LOCAL_UPLOAD_DIR=uploads
UPLOAD_DIR=uploads

# AI runtime providers. Outside tests, these must stay openai.
EVIDENCE_ANALYSIS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EVIDENCE_MODEL=gpt-6-luna
OPENAI_EVIDENCE_TIMEOUT_MS=60000
OPENAI_EVIDENCE_MAX_RETRIES=1
OPENAI_STORE_RESPONSES=false
OPENAI_EVIDENCE_PROMPT_VERSION=evidence-card-v1

# Responses API extraction handles documents; CSV/XLSX rosters stay on local parsers.
OPENAI_AWARD_ROSTER_MODEL=gpt-6-luna
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_EVENT_ROSTER_MODEL=gpt-6-luna
OPENAI_DOCUMENT_EXTRACTION_TIMEOUT_MS=120000
OPENAI_DOCUMENT_EXTRACTION_MAX_RETRIES=2
OPENAI_AWARD_ROSTER_PROMPT_VERSION=award-roster-v1
OPENAI_DECISION_PROMPT_VERSION=decision-document-v1
OPENAI_EVENT_ROSTER_PROMPT_VERSION=event-roster-v1

ASSISTANT_NARRATIVE_PROVIDER=openai
OPENAI_ASSISTANT_MODEL=gpt-6-luna
OPENAI_ASSISTANT_TIMEOUT_MS=45000
OPENAI_ASSISTANT_MAX_RETRIES=1
OPENAI_ASSISTANT_PROMPT_VERSION=dashboard-assistant-v1
STUDENT_ASSISTANT_PROVIDER=openai
OPENAI_STUDENT_ASSISTANT_MODEL=gpt-6-luna
OPENAI_STUDENT_ASSISTANT_PROMPT_VERSION=student-assistant-v1
ASSISTANT_NARRATIVE_CACHE_TTL_MS=900000
ASSISTANT_MOCK_STREAM_DELAY_MS=35

# Optional background jobs. For Cloud Run demo, keep this false unless this service owns workers.
JOB_WORKER_ENABLED=false
JOB_WORKER_INTERVAL_MS=5000
JOB_WORKER_CONCURRENCY=3
JOB_WORKER_MAX_ATTEMPTS=4
JOB_WORKER_RETRY_BASE_DELAY_MS=1000
JOB_WORKER_RETRY_MAX_DELAY_MS=60000
JOB_WORKER_STALE_AFTER_MS=900000
JOB_WORKER_STORAGE_TIMEOUT_MS=30000
INTERNAL_WORKER_TOKEN=

# Token-protected incoming Smartbot compatibility webhook; does not select the chatbot answer provider.
ENABLE_DEMO_REVIEW_BYPASS=false
SMARTBOT_MODE=mock
SMARTBOT_INPUT_CHANNEL=livechat
SMARTBOT_WEBHOOK_TOKEN=

# Set true only for an explicitly requested live smoke; this makes real OpenAI requests.
OPENAI_LIVE_SMOKE=false

# Optional mail.
MAIL_ENABLED=false
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=5TOT
MAIL_FROM_ADDRESS=no-reply@example.edu.vn
APP_BASE_URL=http://localhost:5173
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_BASE_SECONDS=60

# Optional one-off scripts.
ADMIN_EMAIL=admin@dut.udn.vn
ADMIN_PASSWORD=
PERSON2_DEMO_STUDENT_CODE=102220001
PERSON2_DEMO_OTHER_STUDENT_CODE=109990001
